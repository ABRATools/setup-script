[Unit]
Description=ABRA Node Agent
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/nodeapi
ExecStart=/opt/nodeapi/main
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartCounter=3
RestartSec=10
#StandardOutput=syslog
#StandardError=syslog
User=root
Group=root
#Environment=PATH=/s

[Install]
WantedBy=multi-user.target